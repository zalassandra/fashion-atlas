# Never commit real credentials. Keep the populated .env file local.
# A merchant supplies a storefront URL and, when required, Storefront API access.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
# eBay Browse uses an application credential and access token flow.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Pinterest access begins only after its application review.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Meta access must be for an approved Instagram Professional account / permitted public-content flow.
META_APP_ID=
META_APP_SECRET=
META_IG_USER_ID=
