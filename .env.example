# Node 22+: node --env-file=.env scripts/connectors.mjs status
# Never commit populated .env files. No secret is needed for status.
# Optional published UCP JSON profile. The app defaults to this project's
# versioned public catalog-only profile; no Catalog API key is needed.
SHOPIFY_AGENT_PROFILE_URL=
# Domain format: partner-shop.myshopify.com (no scheme or path).
SHOPIFY_STORE_DOMAIN=
# Optional in tokenless mode; otherwise a merchant-issued Storefront public/private token.
SHOPIFY_STOREFRONT_TOKEN=
# eBay: use an existing application access token OR a matching app key pair.
EBAY_ACCESS_TOKEN=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# OAuth token for an app approved for Pinterest Trends. App ID/secret alone cannot query it.
PINTEREST_ACCESS_TOKEN=
# Instagram Login: participating Professional account token with instagram_business_basic.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Optional absolute Git executable path when git is not on PATH.
GIT_EXECUTABLE=
