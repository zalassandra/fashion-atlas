{
  "name": "fashion-atlas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A living editorial archive of fashion signals",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/panel-server.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "sources": "node --env-file-if-exists=.env scripts/connectors.mjs status",
    "validate": "node scripts/validate-snapshot.mjs"
  }
}
